{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laadfix-ocpp-gateway",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-10",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "OCPP_GATEWAY", "class_name": "OcppGateway"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["OcppGateway"]}
  ]
}
